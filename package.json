{
  "name": "swagger-api-tester",
  "displayName": "Swagger API Tester",
  "version": "0.2.0",
  "description": "Deterministic OpenAPI/Swagger contract testing engine exposed to Claude Desktop as an MCP plugin.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:arch": "node scripts/check-architecture.mjs",
    "validate": "node scripts/validate-plugin.mjs",
    "package": "node scripts/package.mjs",
    "gates": "npm run typecheck && npm run lint && npm run check:arch && npm run test"
  },
  "files": [
    ".claude-plugin/plugin.json",
    ".mcp.json",
    "dist/mcp-server.js",
    "README.md",
    "INSTALL.md",
    "API_TESTER.example.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@readme/openapi-parser": "^2.6.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "encoding": "0.1.13",
    "openapi-types": "12.1.3",
    "randexp": "^0.5.3",
    "swagger2openapi": "^7.0.8",
    "undici": "^6.19.8",
    "yaml": "2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/swagger2openapi": "^7.0.4",
    "esbuild": "^0.23.0",
    "eslint": "^9.9.0",
    "fastify": "4.28.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^2.0.5"
  }
}
